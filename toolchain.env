# Pinned WebAssembly toolchain. Every C -> wasm build runs in this image.
#
# Resolved 2026-10-08 via `docker buildx imagetools inspect
# emscripten/emsdk:6.0.11` (digest of the multi-arch manifest list).
# To bump: pick a newer stable tag on https://hub.docker.com/r/emscripten/emsdk/tags,
# resolve its digest the same way, and update this line AND the matching
# `env.EMSDK_IMAGE` in .github/workflows/build-deploy.yml (CI fails if they differ).
EMSDK_IMAGE=emscripten/emsdk:6.0.11@sha256:cdefec943f04fd4b2b2fe23b0a1a346be9fc560ef5784a83faa27dd351381372

# Inside the image (6.0.11, built 2026-10-02):
# - clang / llc / wasm-ld: LLVM 22.1.x (emscripten 6.0.x bundles LLVM 22.1.8;
#   see the emscripten ChangeLog), under /emsdk/upstream/bin and on PATH.
# - emcc 6.0.11, also on PATH.
# - node v24.19.0 (see the PATH in emsdk's docker/Dockerfile at tag 6.0.11).
#   Kept in sync with .nvmrc and package.json engines.node; CI asserts it.
