+// --- range-fetch helpers -------------------------------------------------
+// Full-file fallback cache: servers that ignore Range return 200 with the
+// whole file, so we download once and slice locally.
+const fullBufferCache = new Map(); // url -> Promise<ArrayBuffer>
+async function fetchFull(url) {
+  let pending = fullBufferCache.get(url);
+  if (!pending) {
+    pending = fetch(url).then((res) => {
+      if (!res.ok)
+        throw new Error(`SoundFont fetch failed: ${url} (status ${res.status})`);
+      return res.arrayBuffer();
+    });
+    fullBufferCache.set(url, pending);
+  }
+  return pending;
+}
+
+/** Fetch bytes [start, end]; validates the 206 status, else slices a cached full download. */
+async function fetchRange(url, start, end) {
+  const res = await fetch(url, {
+    headers: { Range: `bytes=${start}-${end}` },
+  }).catch((e) => {
+    throw new Error(`SoundFont fetch failed: ${url}: ${e?.message ?? e}`);
+  });
+  if (res.status === 206) return res.arrayBuffer();
+  const full = await fetchFull(url);
+  return full.slice(start, Math.min(end + 1, full.byteLength));
+}
+
+let _streamsTransferable = null;
+/** Feature-detect whether a ReadableStream can be transferred (Safari throws DataCloneError). */
+function streamsTransferable() {
+  if (_streamsTransferable == null) {
+    try {
+      const rs = new ReadableStream();
+      const mc = new MessageChannel();
+      mc.port1.postMessage({ s: rs }, [rs]);
+      mc.port1.close();
+      mc.port2.close();
+      _streamsTransferable = true;
+    } catch (e) {
+      _streamsTransferable = false;
+    }
+  }
+  return _streamsTransferable;
+}
